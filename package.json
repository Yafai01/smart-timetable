{
  "name": "smart-timetable",
  "private": true,
  "version": "1.0.0",
  "description": "Conflict-free college timetable generator with faculty, subject, class and room management.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "multer": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vitest": "^5.0.4"
  }
}
