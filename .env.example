# Port the server listens on (default: 3001). Hosting platforms usually set this.
PORT=3001

# Interface to bind to (default: 0.0.0.0).
# HOST=0.0.0.0

# Path to the SQLite database file. It is created on first run (default: ./timetable.db).
# DATABASE_PATH=./timetable.db

# Set to "false" to start with an empty database instead of sample data.
# SEED_SAMPLE_DATA=true
